{
  "name": "search-console-mcp",
  "version": "2.5.1",
  "description": "Google Search Console MCP server for Claude Code CLI, run with bun. Fork of Suganthan Mohanadasan's GSC MCP.",
  "main": "src/index.ts",
  "bin": {
    "search-console-mcp": "dist/search-console-mcp.js"
  },
  "scripts": {
    "start": "bun --no-env-file src/index.ts",
    "build": "bun build ./src/index.ts --target=bun --minify --sourcemap=linked --outdir ./dist --entry-naming search-console-mcp.js",
    "typecheck": "tsc -p .",
    "lint": "biome lint src test",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "keywords": [
    "mcp",
    "google-search-console",
    "seo",
    "claude",
    "gsc"
  ],
  "author": "Suganthan Mohanadasan (original author); search-console-mcp contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/bun": "^1.4.5",
    "typescript": "7.0.2"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  }
}
