{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": { "includes": ["src/**", "test/**"] },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noNonNullAssertion": "off", "useTemplate": "off" }
    }
  }
}
